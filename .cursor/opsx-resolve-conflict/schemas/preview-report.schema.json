{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsx-resolve-conflict/preview-report/v1",
  "title": "OPSX resolve-conflict PREVIEW_ONLY advisory report",
  "type": "object",
  "required": [
    "schema",
    "status",
    "package_version",
    "safe_usage_scope",
    "go_capability",
    "CURRENT_CONFLICT",
    "FACTS",
    "OURS",
    "THEIRS",
    "SEMANTIC_CONFLICT",
    "CONTEXT",
    "INTERPRETATIONS",
    "OWNER_DECISIONS_REQUIRED",
    "RESOLUTION_OPTIONS",
    "RECOMMENDATION",
    "VALIDATION_PLAN",
    "LIMITATIONS",
    "MUTATION_ASSERTION",
    "command_ledger",
    "human_report_ru"
  ],
  "properties": {
    "schema": { "const": "opsx-resolve-conflict/preview-report/v1" },
    "status": { "const": "PREVIEW_READY" },
    "safe_usage_scope": { "const": "PREVIEW_ONLY" },
    "go_capability": { "const": false },
    "CURRENT_CONFLICT": { "type": "object" },
    "FACTS": { "type": "array", "items": { "type": "string" } },
    "INTERPRETATIONS": { "type": "array" },
    "OWNER_DECISIONS_REQUIRED": { "type": "array" },
    "RESOLUTION_OPTIONS": { "type": "array", "minItems": 1 },
    "RECOMMENDATION": { "type": ["object", "null"] },
    "LIMITATIONS": { "type": "array", "minItems": 1 },
    "MUTATION_ASSERTION": { "type": "object" },
    "command_ledger": { "type": "array" },
    "human_report_ru": { "type": "string", "minLength": 1 }
  }
}
