{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "custom": {
      "format": "%(name)s - %(asctime)s - %(pathname)s:%(lineno)d - %(levelname)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "my_log_handler": {
      "class": "my_log_handler.ScriptHandler",
      "level": "ERROR"
    },
    "console": {
      "class": "logging.StreamHandler",
      "level": "DEBUG",
      "formatter": "custom",
      "stream": "ext://sys.stdout"
    },
    "common_file":{
        "class": "logging.handlers.RotatingFileHandler",
        "level": "DEBUG",
        "formatter": "custom",
        "filename": "logs/common.log",
        "mode": "a",
        "encoding": "utf-8",
        "maxBytes": 10485760,
        "backupCount": 5
    },


   "error_to_file": {
        "class": "logging.handlers.RotatingFileHandler",
        "level": "ERROR",
        "formatter": "custom",
        "filename": "logs/errors.log",
        "mode": "a",
        "encoding": "utf-8",
        "maxBytes": 10485760,
        "backupCount": 5
    }
  },


    "app.modules.wb_keywords_parser.parser": {
      "level": "DEBUG",
      "handlers": ["common_file"]
    },


  "root": {
    "level": "DEBUG",
    "handlers": ["console", "error_to_file", "common_file", "my_log_handler"]
  }
}


