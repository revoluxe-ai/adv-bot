{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "custom": {
      "format": "%(name)s - %(asctime)s - %(pathname)s:%(lineno)d - %(levelname)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "DEBUG",
      "formatter": "custom",
      "stream": "ext://sys.stdout"
    },
    "sql_handler": {
        "class": "logging.handlers.RotatingFileHandler",
        "level": "DEBUG",
        "formatter": "custom",
        "filename": "sql.log",
        "mode": "a",
        "encoding": "utf-8",
        "maxBytes": 10485760,
        "backupCount": 100
    },

    "file": {
      "class": "logging.FileHandler",
      "level": "ERROR",
      "formatter": "custom",
      "filename": "errors.log",
      "mode": "a",
      "encoding": "utf-8"
    }
  },
  "loggers": {
    "neo4j": {
      "level": "WARNING",
      "handlers": ["console"],
      "propagate": false
    },
    "asyncio": {
      "level": "WARNING",
      "handlers": ["console"],
      "propagate": false
    },
    "fit_logger": {
      "level": "DEBUG",
      "handlers": ["console"],
      "propagate": false
    },
    "wb.keyword_async_ml_updater.data_managers": {
      "level": "DEBUG",
      "handlers": ["console"],
      "propagate": false
    },

    "gensim.models.keyedvectors": {
      "level": "CRITICAL",
      "handlers": ["console"],
      "propagate": false
    },
    "sqlalchemy.engine": {
      "level": "DEBUG",
      "handlers": ["sql_handler"],
      "propagate": false
    },
    "app.wildberries.ABC_WB_API": {
      "level": "ERROR",
      "handlers": ["console"],
      "propagate": false
    },
    "NeoDataScience.driver": {
      "level": "WARNING",
      "handlers": ["console"],
      "propagate": false
    }
  },
  "root": {
    "level": "DEBUG",
    "handlers": ["console"]
  }
}
