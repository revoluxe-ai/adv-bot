{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "custom": {
      "format": "%(name)s - %(asctime)s - %(pathname)s:%(lineno)d - %(levelname)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "my_log_handler": {
      "class": "my_log_handler.ScriptHandler",
      "level": "ERROR"
    },
    "console": {
      "class": "logging.StreamHandler",
      "level": "DEBUG",
      "formatter": "custom",
      "stream": "ext://sys.stdout"
    },
    "common_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "custom",
      "filename": "logs/common.log",
      "mode": "a",
      "encoding": "utf-8",
      "maxBytes": 10485760,
      "backupCount": 5
    },
    "error_to_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "ERROR",
      "formatter": "custom",
      "filename": "logs/errors.log",
      "mode": "a",
      "encoding": "utf-8",
      "maxBytes": 10485760,
      "backupCount": 5
    }
  },

  "loggers": {
    "updater": {
      "level": "DEBUG",
      "handlers": ["common_file"]
    },
    "app.modules.wb_adv_updater.data_manager": {
        "level": "INFO",
        "handlers": ["console"],
        "propagate": false
        },
    "app.modules.wb_adv_updater.wb_manager": {
        "level": "INFO",
        "handlers": ["common_file"],
        "propagate": false
        },
    "app.modules.wb_adv_updater.data_setter": {
        "level": "DEBUG",
        "handlers": ["common_file"],
        "propagate": false
        },
    "neo4j.io": {
        "level": "CRITICAL",
        "handlers": ["common_file"],
        "propagate": false
        },
    "app.utils.db.session_maker": {
        "level": "CRITICAL",
        "handlers": ["common_file"],
        "propagate": false
        },
    "app.modules.wb_adv_updater.bidder": {
        "level": "DEBUG",
        "handlers": ["common_file"],
        "propagate": true
        }

    },
  "root": {
    "level": "INFO",
    "formatters": ["custom"],
    "handlers": ["console", "common_file", "error_to_file"]
  }
}
