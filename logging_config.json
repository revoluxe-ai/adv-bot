{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "custom": {
      "format": "%(name)s - %(asctime)s - %(pathname)s:%(lineno)d - %(levelname)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "DEBUG",
      "formatter": "custom",
      "stream": "ext://sys.stdout"
    },
    "error_to_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "ERROR",
      "formatter": "custom",
      "filename": "logs/errors.log",
      "mode": "a",
      "encoding": "utf-8",
      "maxBytes": 10485760,
      "backupCount": 5
    },
    "journal": {
      "class": "logging.handlers.SysLogHandler",
      "level": "DEBUG",
      "formatter": "custom",
      "address": "/dev/log"
    }
  },
  "loggers": {
    "updater": {
      "level": "CRITICAL",
      "handlers": ["console"],
      "propagate": false
    },
    "app.modules.wb_adv_updater.data_manager": {
      "level": "CRITICAL",
      "handlers": ["console"],
      "propagate": false
    },
    "app.modules.wb_adv_updater.wb_manager": {
      "level": "CRITICAL",
      "handlers": ["console"],
      "propagate": false
    },
    "neo4j.io": {
      "level": "CRITICAL",
      "handlers": ["console"],
      "propagate": false
    },
    "app.utils.db.session_maker": {
      "level": "CRITICAL",
      "handlers": ["console"],
      "propagate": false
    },
    "app.modules.wb_adv_updater.bidder": {
      "level": "CRITICAL",
      "handlers": ["console"],
      "propagate": false
    },
    "app.modules.wb_adv_updater.ML": {
      "level": "CRITICAL",
      "handlers": ["console"],
      "propagate": false
    },
    "app.modules.wb_adv_updater.fitter": {
      "level": "DEBUG",
      "handlers": ["console"],
      "propagate": false
    }
  },
  "root": {
    "level": "DEBUG",
    "handlers": ["console", "error_to_file", "journal"]
  }
}
