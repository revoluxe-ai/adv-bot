@pytest.fixture(name="async_session")
async def _async_session(async_engine) -> AsyncGenerator[AsyncSession, None]:
    """Создаёт async сессию с откатом после теста."""
    async_session_maker = async_sessionmaker(async_engine, expire_on_commit=False)
    async with async_session_maker() as session:
        trans = await session.begin()
        try:
            yield session
        finally:
            if trans.is_active:
                await trans.rollback()
            await session.close()


@pytest_asyncio.fixture(scope="session")
async def clickhouse_client_session() -> AsyncGenerator[AsyncClient, None]:
    """
    Создаёт ClickHouse async клиент для тестовой сессии с максимум 5 попытками подключения.
    
    Параметры подключения:
    - host: 127.0.0.1
    - port: 9001 (Native протокол)
    - user: test_user
    - password: test_password
    - database: test_db
    
    Используется как зависимость для function-scoped clickhouse_client фиксчуры.
    
    Пример использования в тесте:
    
        @pytest.mark.asyncio
        async def test_with_clickhouse(clickhouse_client):
            result = await clickhouse_client.query("SELECT 1")
            assert result.result_rows[0][0] == 1
    
    Для создания таблиц используйте:
    
        await clickhouse_client.command('''
            CREATE TABLE IF NOT EXISTS my_table (
                id UInt32,
                value String
            ) ENGINE = MergeTree()
            ORDER BY id
        ''')
    
    Для вставки данных используйте:
    
        await clickhouse_client.insert(
            "my_table",
            [[1, "value1"], [2, "value2"]],
            column_names=["id", "value"]
        )
    
    Для запроса данных используйте:
    
        result = await clickhouse_client.query("SELECT * FROM my_table")
        rows = result.result_rows  # список кортежей
    """
    max_retries = 5
    client = None
    
    for attempt in range(max_retries):
        try:
            client = await clickhouse_connect.create_async_client(
                host=TEST_CLICKHOUSE_HOST,
                port=TEST_CLICKHOUSE_PORT,
                username=TEST_CLICKHOUSE_USER,
                password=TEST_CLICKHOUSE_PASSWORD,
                database=TEST_CLICKHOUSE_DB,
                connect_timeout=10,
            )
            print(f"[OK] ClickHouse client connected on attempt {attempt + 1}")
            break
        except Exception as e:
            if attempt < max_retries - 1:
                print(f"[RETRY] ClickHouse connection attempt {attempt + 1}/{max_retries} failed: {e}")
                time.sleep(2)
            else:
                raise RuntimeError(
                    f"Failed to connect to ClickHouse after {max_retries} attempts: {e}"
                ) from e
    
    assert client is not None, "ClickHouse client is None"
    yield client
    
    # Закрытие подключения после тестов
    if client:
        client.close()


