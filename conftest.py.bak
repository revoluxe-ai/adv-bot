@pytest_asyncio.fixture(scope="session", autouse=True)
async def setup_test_database(docker_compose_cmd):
    """Синхронная фикстура для настройки тестовой базы данных с помощью Docker Compose и Alembic."""
    print(f"\n[SETUP] Starting Docker Compose: {COMPOSE_FILE}")

    # --- Запуск Docker Compose ---
    rc, out, err = _sync_run(*docker_compose_cmd, "-f", COMPOSE_FILE, "up", "-d", "--build", timeout=300)
    if rc != 0:
        raise RuntimeError(f"Failed to start Docker Compose services. rc={rc} stderr={err}")

    # --- Ожидание запуска контейнера ---
    container_id: str = ""
    max_retries = 30
    for i in range(max_retries):
        rc, cid_out, _ = _sync_run(*docker_compose_cmd, "-f", COMPOSE_FILE, "ps", "-q", "test_db", timeout=10)
        container_id = cid_out.strip()
        if container_id:
            _DOCKER_CLEANUP_STATE["container_id"] = container_id  # Сохраняем для emergency cleanup
            rc, health, _ = _sync_run(
                "docker", "inspect", "--format", "{{.State.Health.Status}}", container_id, timeout=10
            )
            if rc == 0 and health.strip() == "healthy":
                print("[OK] Test database is healthy.")
                # Даём дополнительное время для полной готовности БД к приёму соединений
                time.sleep(2)
                break
        print(f"[WAIT] Waiting for test database... Attempt {i + 1}/{max_retries}")
        time.sleep(2)
    else:
        # Если так и не дождались health=healthy — покажем статус и логи для диагностики
        _sync_run("docker", "ps", "-a", timeout=10)
        if container_id:
            _sync_run("docker", "logs", container_id, timeout=10)
        raise RuntimeError("Test database did not become healthy in time.")

    # --- Ожидание ClickHouse контейнера ---
    clickhouse_container_id: str = ""
    max_retries_ch = 60 # Увеличено с 30 до 60
    for i in range(max_retries_ch):
        rc, ch_cid_out, _ = _sync_run(
            *docker_compose_cmd, "-f", COMPOSE_FILE, "ps", "-q", "test_clickhouse", timeout=10
        )
        clickhouse_container_id = ch_cid_out.strip()
        if clickhouse_container_id:
            _DOCKER_CLEANUP_STATE["clickhouse_container_id"] = clickhouse_container_id
            rc, health, _ = _sync_run(
                "docker", "inspect", "--format", "{{.State.Health.Status}}", clickhouse_container_id, timeout=10
            )
            if rc == 0 and health.strip() == "healthy":
                print("[OK] ClickHouse database is healthy.")
                # Даём дополнительное время для полной готовности БД к приёму соединений
                time.sleep(2) 

                # --- Создание таблицы ClickHouse ---
                print("[MIGRATION] Creating ClickHouse table 'keyword_position_from_api'...")
                client = None # Инициализируем client вне try, чтобы он был доступен в finally
                try:
                    client = await clickhouse_connect.create_async_client(
                        host=TEST_CLICKHOUSE_HOST,
                        port=TEST_CLICKHOUSE_PORT, # Использование Native порта 9001
                        username=TEST_CLICKHOUSE_USER,
                        password=TEST_CLICKHOUSE_PASSWORD,
                        database=TEST_CLICKHOUSE_DB, # Указываем базу данных сразу
                        connect_timeout=10,
                    )
                    # await client.command(f"CREATE DATABASE IF NOT EXISTS {TEST_CLICKHOUSE_DB}") # Это уже не нужно, т.к. база указывается при подключении
                    # print(f"[OK] ClickHouse database '{TEST_CLICKHOUSE_DB}' created (if not exists).")
                    await client.command("""
                        CREATE TABLE IF NOT EXISTS default_db.keyword_position_from_api
                        (
                            nmid         Int32,
                            text         String,
                            avr_position Float32,
                            total_views  Int32,
                            orders       Int32,
                            date         Date,
                            version      UInt64
                        )
                        ENGINE = ReplacingMergeTree(version)
                            ORDER BY (nmid, date)
                            SETTINGS index_granularity = 8192;
                    """)
                    print("[OK] ClickHouse table 'keyword_position_from_api' created successfully.")
                except Exception as e:
                    raise RuntimeError(f"Failed to create ClickHouse table: {e}") from e
                finally:
                    if client is not None:
                        await client.close()
                
                break
        print(f"[WAIT] Waiting for ClickHouse... Attempt {i + 1}/{max_retries_ch}")
        time.sleep(2)
    else:
        # Если так и не дождались health=healthy для ClickHouse — показываем логи и предупреждение
        print("[WARNING] ClickHouse did not become healthy in time. Tests may fail.")
        if clickhouse_container_id:
            _sync_run("docker", "logs", clickhouse_container_id, timeout=10)
        # Не прерываем остаток setup, так как ClickHouse может быть опциональным

    from app.utils.db.base import BaseTable as Base
    from sqlalchemy import create_engine

    print("[MIGRATION] Creating PostgreSQL extensions...")

    # Создаём синхронный движок для создания расширений и таблиц
    # Используем 127.0.0.1 вместо localhost для принудительного использования IPv4
    sync_db_url = TEST_DB_URL.replace("postgresql+asyncpg", "postgresql")
    sync_engine = create_engine(
        sync_db_url,
        connect_args={"connect_timeout": 10},
        pool_pre_ping=True,
    )

    # Создаём необходимые расширения PostgreSQL ПЕРЕД созданием таблиц
    # Добавляем retry логику для надежности
    max_connection_retries = 5
    for attempt in range(max_connection_retries):
        try:
            with sync_engine.connect() as conn:
                conn.execute(text("CREATE EXTENSION IF NOT EXISTS pg_trgm;"))
                conn.commit()
            break
        except Exception as e:
            if attempt < max_connection_retries - 1:
                print(f"[RETRY] Connection attempt {attempt + 1}/{max_connection_retries} failed, retrying...")
                time.sleep(1)
            else:
                raise RuntimeError(f"Failed to connect to database after {max_connection_retries} attempts: {e}") from e

    print("[MIGRATION] Creating tables from models metadata...")
    Base.metadata.create_all(sync_engine)
    sync_engine.dispose()
    print("[OK] Tables created successfully from models metadata.")

    # Проставляем миграции Alembic как применённые
    from alembic.config import Config
    from alembic import command

    print("[MIGRATION] Stamping Alembic migrations for test database...")
    alembic_cfg = Config("alembic.ini")
    alembic_cfg.set_main_option("script_location", "alembic_")
    alembic_cfg.set_main_option("sqlalchemy.url", TEST_DB_URL)
    command.stamp(alembic_cfg, "head")
    print("[OK] Alembic migrations stamped successfully.")

    # --- Базовые данные (async) ---
    # Создаём минимальный event loop только для этой задачи
    # loop = asyncio.new_event_loop()
    # asyncio.set_event_loop(loop)
    try:
        async def insert_initial_data(engine: AsyncEngine):
            async with engine.begin() as conn:
                initial_wb_cabinet_data = {
                    "id": 1,
                    "shop_id": "test_shop_id",
                    "active": True,
                    "expiration_time": datetime.now() + timedelta(days=7),
                    "balance": 0.0,
                    "bonus": 0.0,
                    "demo": True,
                    "expiration_alarm_days_pass": None,
                    "white_list_update_active": False,
                }
                insert_stmt = insert(WBCabinet).values(initial_wb_cabinet_data)
                on_conflict_stmt = insert_stmt.on_conflict_do_update(
                    index_elements=["id"],
                    set_={k: v for k, v in initial_wb_cabinet_data.items() if k != "id"},
                )
                await conn.execute(on_conflict_stmt)
                await conn.commit()
            await engine.dispose()

        # loop.run_until_complete(insert_initial_data())
        engine_async = create_async_engine(TEST_DB_URL)
        await insert_initial_data(engine_async)
    finally:
        # loop.close()
        pass

    print("[OK] Test database setup complete.")

    yield

    # --- TEARDOWN ---
    print(f"\n[CLEANUP] Stopping Docker Compose: {COMPOSE_FILE}")

    # Сначала пытаемся остановить контейнеры gracefully
    if container_id:
        _sync_run("docker", "stop", "-t", "2", container_id, timeout=10)
    if clickhouse_container_id:
        _sync_run("docker", "stop", "-t", "2", clickhouse_container_id, timeout=10)

    # Затем compose down с очень коротким таймаутом
    rc, _, err = _sync_run(
        *docker_compose_cmd,
        "-f",
        COMPOSE_FILE,
        "down",
        "-v",
        "--remove-orphans",
        "--timeout",
        "1",
        timeout=20,
    )
    if rc != 0:
        print(f"[WARNING] 'compose down' failed rc={rc}: {err.strip()}")

    # Финальная зачистка
    if container_id:
        _sync_run("docker", "rm", "-f", container_id, timeout=10)
        _DOCKER_CLEANUP_STATE["container_id"] = None
    if clickhouse_container_id:
        _sync_run("docker", "rm", "-f", clickhouse_container_id, timeout=10)
        _DOCKER_CLEANUP_STATE["clickhouse_container_id"] = None

    print("[OK] Cleanup complete.")

    # --- Очистка ClickHouse таблиц ---
    print("[CLEANUP] Dropping ClickHouse table 'keyword_position_from_api'...")
    client = None # Инициализируем client вне try, чтобы он был доступен в finally
    try:
        client = await clickhouse_connect.create_async_client(
            host=TEST_CLICKHOUSE_HOST,
            port=TEST_CLICKHOUSE_PORT, # Используем Native порт 9001
            username=TEST_CLICKHOUSE_USER,
            password=TEST_CLICKHOUSE_PASSWORD,
            database=TEST_CLICKHOUSE_DB,
            connect_timeout=10,
        )
        await client.command("DROP TABLE IF EXISTS default_db.keyword_position_from_api;")
        print("[OK] ClickHouse table 'keyword_position_from_api' dropped successfully.")
    except Exception as e:
        print(f"[WARNING] Failed to drop ClickHouse table: {e}")
    finally:
        if client is not None:
            await client.close()


@pytest.fixture(scope="function", name="async_engine")
async def _async_engine():
