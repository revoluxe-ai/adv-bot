"""Smoke tests for UpdateCPMManager with PromotionManager integration."""

import pytest
from unittest.mock import AsyncMock, Mock, patch
from types import SimpleNamespace

from app.modules.shop_runner.service_manager.services.update_cpm.update_cpm_manager import UpdateCPMManager
from app.core.mp.wb.managers.promotion import PromotionManager
from app.modules.common_slaves.wildberries.data_classes.keywordstat_from_db import CalculatedKeyword
from app.modules.common_slaves.wildberries.models import AdvSetting


class TestUpdateCPMManager:
    """Test cases for UpdateCPMManager with mocked PromotionManager."""

    @pytest.fixture
    def mock_promotion_manager(self):
        """Create a mock PromotionManager."""
        manager = Mock(spec=PromotionManager)
        manager.get_min_bids = AsyncMock(return_value={123: 10, 456: 15})
        manager.get_current_bids = AsyncMock(return_value={123: 20, 456: 25})
        manager.update_bids = AsyncMock()
        return manager

    @pytest.fixture
    def update_cpm_manager(self, mock_promotion_manager):
        """Create UpdateCPMManager with mocked PromotionManager."""
        return UpdateCPMManager("test_shop", mock_promotion_manager)

    @pytest.fixture
    def sample_adv_setting(self):
        """Create a sample AdvSetting for testing."""
        adv = Mock(spec=AdvSetting)
        adv.search_adv_id = 100
        adv.nmids = [123, 456]
        adv.max_cpm = 100
        adv.max_place = 5
        adv.bidder_step = 2
        return adv

    @pytest.fixture
    def sample_keywords(self):
        """Create sample keywords."""
        keyword = Mock(spec=CalculatedKeyword)
        keyword.text = "test keyword"
        keyword.score = 0.8
        return [keyword]

    @pytest.mark.asyncio
    async def test_update_cpm_manager_initialization(self, mock_promotion_manager):
        """Test that UpdateCPMManager initializes correctly."""
        # Act
        manager = UpdateCPMManager("test_shop", mock_promotion_manager)

        # Assert
        assert manager._shop_id == "test_shop"
        assert manager._promotion_manager is mock_promotion_manager
        assert manager._DEFAULT_BIDDER_STEP == 2

    @pytest.mark.asyncio
    async def test_get_min_bids_delegation(self, update_cpm_manager, mock_promotion_manager):
        """Test that get_min_bids delegates to PromotionManager."""
        # Arrange
        adv_id = 100
        nmids = [123, 456]
        expected_result = {123: 10, 456: 15}
        mock_promotion_manager.get_min_bids.return_value = expected_result

        # Act
        result = await update_cpm_manager.get_min_bids(adv_id, nmids)

        # Assert
        mock_promotion_manager.get_min_bids.assert_called_once_with(
            "test_shop", adv_id=adv_id, nmids=nmids
        )
        assert result == expected_result

    @pytest.mark.asyncio
    async def test_get_current_bids_delegation(self, update_cpm_manager, mock_promotion_manager):
        """Test that get_current_bids delegates to PromotionManager."""
        # Arrange
        adv_id = 100
        nmids = [123, 456]
        expected_result = {123: 20, 456: 25}
        mock_promotion_manager.get_current_bids.return_value = expected_result

        # Act
        result = await update_cpm_manager.get_current_bids(adv_id, nmids)

        # Assert
        mock_promotion_manager.get_current_bids.assert_called_once_with(
            "test_shop", adv_id=adv_id, nmids=nmids
        )
        assert result == expected_result

    @pytest.mark.asyncio
    async def test_update_bids_delegation(self, update_cpm_manager, mock_promotion_manager):
        """Test that update_bids delegates to PromotionManager."""
        # Arrange
        adv_id = 100
        nm_bids = [{"nm": 123, "cpm": 30}, {"nm": 456, "cpm": 35}]

        # Act
        await update_cpm_manager.update_bids(adv_id, nm_bids)

        # Assert
        mock_promotion_manager.update_bids.assert_called_once_with(
            "test_shop", adv_id=adv_id, nm_bids=nm_bids
        )

    @pytest.mark.asyncio
    async def test_update_cpms_in_search_advs_empty_list(self, update_cpm_manager):
        """Test handling of empty advertisement list."""
        # Act
        await update_cpm_manager.update_cpms_in_search_advs([])

        # Assert - should complete without errors

    @pytest.mark.asyncio
    async def test_process_single_adv_missing_required_params(
        self, update_cpm_manager, sample_keywords
    ):
        """Test skipping advertisement with missing required parameters."""
        # Arrange
        adv = Mock(spec=AdvSetting)
        adv.search_adv_id = None  # Missing required param
        adv.nmids = [123]
        adv.max_cpm = 100
        adv.max_place = 5
        adv.bidder_step = 2

        keywords_coro = AsyncMock(return_value=sample_keywords)

        # Act
        await update_cpm_manager._process_single_adv(adv, keywords_coro())

        # Assert - should complete without making API calls
        assert not update_cpm_manager._promotion_manager.get_min_bids.called

    @pytest.mark.asyncio
    @patch('app.modules.wb_adv_updater.data_manager.get_best_keyword')
    @patch('app.utils.redis_manager.get_keyword_position')
    async def test_process_single_adv_with_bid_updates(
        self, mock_get_position, mock_get_best_keyword, update_cpm_manager,
        mock_promotion_manager, sample_adv_setting, sample_keywords
    ):
        """Test successful processing of advertisement with bid updates."""
        # Arrange
        mock_get_best_keyword.return_value = sample_keywords[0]

        # Mock position data
        position = SimpleNamespace()
        position.position = 10  # Below target position, should increase bid
        mock_get_position.return_value = position

        keywords_coro = AsyncMock(return_value=sample_keywords)

        # Act
        await update_cpm_manager._process_single_adv(sample_adv_setting, keywords_coro())

        # Assert
        mock_promotion_manager.get_min_bids.assert_called_once_with(
            "test_shop", adv_id=100, nmids=[123, 456]
        )
        mock_promotion_manager.get_current_bids.assert_called_once_with(
            "test_shop", adv_id=100, nmids=[123, 456]
        )
        # Should call update_bids if new bids were calculated
        assert mock_promotion_manager.update_bids.call_count <= 1

    @pytest.mark.asyncio
    @patch('app.modules.wb_adv_updater.data_manager.get_best_keyword')
    async def test_process_single_adv_no_best_keyword(
        self, mock_get_best_keyword, update_cpm_manager,
        sample_adv_setting, sample_keywords
    ):
        """Test skipping when no best keyword is found."""
        # Arrange
        mock_get_best_keyword.return_value = None
        keywords_coro = AsyncMock(return_value=sample_keywords)

        # Act
        await update_cpm_manager._process_single_adv(sample_adv_setting, keywords_coro())

        # Assert - should skip API calls
        assert not update_cpm_manager._promotion_manager.get_min_bids.called

    @pytest.mark.asyncio
    @patch('app.utils.redis_manager.get_keyword_position')
    async def test_calculate_new_bid_invalid_position(
        self, mock_get_position, update_cpm_manager, sample_keywords
    ):
        """Test skipping bid calculation when position is invalid."""
        # Arrange
        mock_get_position.return_value = None  # Invalid position

        # Act
        result = await update_cpm_manager._calculate_new_bid_for_nmid(
            nmid=123,
            best_keyword=sample_keywords[0],
            min_bids_map={123: 10},
            current_bids_map={123: 20},
            max_bid=100,
            target_position=5,
            bidder_step=2
        )

        # Assert
        assert result is None

    @pytest.mark.asyncio
    @patch('app.utils.redis_manager.get_keyword_position')
    async def test_calculate_new_bid_successful(
        self, mock_get_position, update_cpm_manager, sample_keywords
    ):
        """Test successful bid calculation."""
        # Arrange
        position = SimpleNamespace()
        position.position = 10  # Below target, should increase bid
        mock_get_position.return_value = position

        # Act
        result = await update_cpm_manager._calculate_new_bid_for_nmid(
            nmid=123,
            best_keyword=sample_keywords[0],
            min_bids_map={123: 10},
            current_bids_map={123: 20},
            max_bid=100,
            target_position=5,
            bidder_step=2
        )

        # Assert
        assert result is not None
        assert isinstance(result, int)
        assert result != 20  # Should be different from current bid

    @pytest.mark.asyncio
    async def test_update_cpms_error_handling(
        self, update_cpm_manager, sample_adv_setting, mock_promotion_manager
    ):
        """Test error handling in update_cpms_in_search_advs."""
        # Arrange
        mock_promotion_manager.get_min_bids.side_effect = Exception("API Error")
        keywords_coro = AsyncMock(return_value=[])

        adv_settings_and_keywords = [(sample_adv_setting, keywords_coro())]

        # Act - should not raise exception
        await update_cpm_manager.update_cpms_in_search_advs(adv_settings_and_keywords)

        # Assert - error should be logged but not propagated
        # (In real scenario, we'd check logs, but here we just verify no exception)

    @pytest.mark.asyncio
    async def test_bid_calculator_integration(self, update_cpm_manager):
        """Test integration with BidCalculator."""
        # Arrange
        manager = update_cpm_manager

        # Act & Assert - BidCalculator should be initialized
        assert manager._bid_calculator is not None
        assert hasattr(manager._bid_calculator, 'calculate_new_bid')
