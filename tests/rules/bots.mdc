# Правила для тестирования ботов

## Основные требования
- Мокировать Telegram API
- Тестировать все состояния FSM
- Проверять обработку callback-запросов
- Тестировать навигацию между состояниями
- Проверять обработку ошибок
- Тестировать параллельную работу ботов

## Пример фикстуры для тестирования бота
```python
@pytest.fixture
def bot():
    bot = Bot(token="test_token")
    bot.session = AsyncMock()
    return bot

@pytest.fixture
def dispatcher():
    dp = Dispatcher()
    dp.storage = AsyncMock()
    return dp
```

## Тестирование обработки команд
```python
@pytest.mark.asyncio
async def test_command_handler(bot, dispatcher):
    # Регистрация обработчика
    @dp.message_handler(commands=["start"])
    async def start_handler(message: Message):
        await message.answer("Hello!")
    
    # Создание тестового сообщения
    message = Message(
        message_id=1,
        date=datetime.now(),
        chat=Chat(id=1, type="private"),
        text="/start"
    )
    
    # Выполнение обработки
    await dp.process_message(message)
    
    # Проверка
    bot.send_message.assert_called_once_with(
        chat_id=1,
        text="Hello!"
    )
```

## Тестирование FSM
```python
@pytest.mark.asyncio
async def test_fsm_transition(bot, dispatcher):
    # Регистрация состояний
    class TestStates(StatesGroup):
        state1 = State()
        state2 = State()
    
    # Регистрация обработчиков
    @dp.message_handler(state=TestStates.state1)
    async def state1_handler(message: Message, state: FSMContext):
        await state.set_state(TestStates.state2)
        await message.answer("State changed")
    
    # Установка начального состояния
    await dispatcher.storage.set_state(
        chat=1,
        user=1,
        state=TestStates.state1
    )
    
    # Создание сообщения
    message = Message(
        message_id=1,
        date=datetime.now(),
        chat=Chat(id=1, type="private"),
        text="test"
    )
    
    # Выполнение обработки
    await dp.process_message(message)
    
    # Проверка
    bot.send_message.assert_called_once_with(
        chat_id=1,
        text="State changed"
    )
    assert await dispatcher.storage.get_state(
        chat=1,
        user=1
    ) == TestStates.state2
```

## Тестирование callback-запросов
```python
@pytest.mark.asyncio
async def test_callback_handler(bot, dispatcher):
    # Регистрация обработчика
    @dp.callback_query_handler(lambda c: c.data == "test")
    async def callback_handler(callback: CallbackQuery):
        await callback.answer("Callback processed")
    
    # Создание callback-запроса
    callback = CallbackQuery(
        id="1",
        from_user=User(id=1, is_bot=False, first_name="Test"),
        message=Message(
            message_id=1,
            date=datetime.now(),
            chat=Chat(id=1, type="private")
        ),
        data="test"
    )
    
    # Выполнение обработки
    await dp.process_callback_query(callback)
    
    # Проверка
    bot.answer_callback_query.assert_called_once_with(
        callback_query_id="1",
        text="Callback processed"
    )
```

## Тестирование обработки ошибок
```python
@pytest.mark.asyncio
async def test_error_handler(bot, dispatcher):
    # Регистрация обработчика ошибок
    @dp.errors_handler()
    async def error_handler(update, error):
        await update.message.answer("Error occurred")
        return True
    
    # Создание сообщения с ошибкой
    message = Message(
        message_id=1,
        date=datetime.now(),
        chat=Chat(id=1, type="private"),
        text="test"
    )
    
    # Выполнение обработки с ошибкой
    with pytest.raises(Exception):
        await dp.process_message(message)
    
    # Проверка
    bot.send_message.assert_called_once_with(
        chat_id=1,
        text="Error occurred"
    )
```

## Тестирование параллельной работы
```python
@pytest.mark.asyncio
async def test_concurrent_bot_operations(bot, dispatcher):
    # Создание нескольких сообщений
    messages = [
        Message(
            message_id=i,
            date=datetime.now(),
            chat=Chat(id=1, type="private"),
            text=f"message {i}"
        )
        for i in range(5)
    ]
    
    # Параллельная обработка
    tasks = [
        dp.process_message(message)
        for message in messages
    ]
    
    # Выполнение
    await asyncio.gather(*tasks)
    
    # Проверка
    assert bot.send_message.call_count == 5
``` 