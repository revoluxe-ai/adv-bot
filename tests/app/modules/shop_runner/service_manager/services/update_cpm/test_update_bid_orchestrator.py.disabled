"""Comprehensive tests for UpdateBidOrchestrator and UpdateBatch classes."""

import asyncio
import pytest
from unittest.mock import AsyncMock, Mock, patch, MagicMock
from typing import Any

# Create a simplified test file that focuses on functionality over type checking
class TestUpdateBidOrchestrator:
    """Test cases for UpdateBidOrchestrator class with comprehensive mocking."""

    @pytest.fixture
    def mock_queue(self):
        """Create a mock asyncio queue."""
        return asyncio.Queue()

    @pytest.fixture
    def mock_stop_event(self):
        """Create a mock asyncio event."""
        return asyncio.Event()

    @pytest.fixture
    def shop_id(self):
        """Return test shop ID."""
        return "test_shop_123"

    @pytest.fixture
    def mock_command(self):
        """Create a mock command object."""
        command = Mock()
        command.adv_id = 100
        command.nmid = 123
        command.new_bid = 75
        return command

    @pytest.fixture
    def mock_send_command(self):
        """Create a mock send command object."""
        command = Mock()
        command.adv_id = 100
        command.nmid = 123
        command.max_cmp_bid = 100
        return command

    @pytest.mark.asyncio
    async def test_update_batch_class_basic_functionality(self):
        """Test UpdateBatch class basic functionality with mocking."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            # Create a mock batch instance
            batch_instance = Mock()
            batch_instance.commands = {}
            batch_instance.is_empty.return_value = True
            batch_instance.get_adv_ids.return_value = []
            batch_instance.add_command = Mock()
            batch_instance.get_nmids_bids_for_adv.return_value = []
            batch_instance.pop_adv_commands.return_value = {}
            batch_instance.clear = Mock()
            
            MockBatch.return_value = batch_instance
            
            # Test initialization
            batch = MockBatch()
            assert batch.is_empty()
            assert batch.get_adv_ids() == []
            
            # Test adding commands
            mock_command = Mock()
            batch.add_command(mock_command)
            batch.add_command.assert_called_once_with(mock_command)
            
            # Test getting nmids_bids
            result = batch.get_nmids_bids_for_adv(100)
            assert result == []
            
            # Test popping commands
            result = batch.pop_adv_commands([100])
            assert result == {}
            
            # Test clear
            batch.clear()
            batch.clear.assert_called_once()

    @pytest.mark.asyncio
    async def test_orchestrator_initialization_with_mocking(self, mock_queue, mock_stop_event, shop_id):
        """Test UpdateBidOrchestrator initialization with proper mocking."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager') as MockCpmManager, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater') as MockUpdater, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Import the class after mocking
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            
            # Verify initialization
            assert orchestrator._queue is mock_queue
            assert orchestrator._stop_event is mock_stop_event
            assert orchestrator._shop_id == shop_id
            assert orchestrator.MAX_ADV_IDS_PER_BATCH == 50
            assert orchestrator.QUEUE_GET_TIMEOUT_SEC == 1.0
            assert orchestrator.BATCH_IDLE_SLEEP_SEC == 0.05
            
            # Verify mocked components were created
            MockCpmManager.assert_called_once()
            MockUpdater.assert_called_once_with(shop_id)
            MockBatch.assert_called_once()

    @pytest.mark.asyncio
    async def test_send_update_command_to_queue(self, mock_queue, mock_stop_event, shop_id, mock_send_command):
        """Test sending update command to queue."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager') as MockCpmManager, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch'), \
             patch('app.shared.application.commands.search_adv_bid_update.update_bid_command.BidUpdateForNmidCommand') as MockBidUpdateCommand:
            
            # Setup mocks
            mock_cpm_manager = Mock()
            mock_cpm_manager.get_new_cpm_bid = AsyncMock(return_value=75)
            MockCpmManager.return_value = mock_cpm_manager
            
            mock_bid_command = Mock()
            MockBidUpdateCommand.return_value = mock_bid_command
            
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            orchestrator._new_cpm_manager = mock_cpm_manager
            
            # Test the method
            await orchestrator.send_update_command_to_queue(mock_send_command)
            
            # Verify the flow
            mock_cpm_manager.get_new_cpm_bid.assert_called_once_with(mock_send_command)
            MockBidUpdateCommand.assert_called_once()
            
            # Check that something was added to queue
            assert mock_queue.qsize() == 1

    @pytest.mark.asyncio 
    async def test_update_batch_processes_queue_items(self, mock_queue, mock_stop_event, shop_id, mock_command):
        """Test that update_batch processes items from queue."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Setup batch mock
            batch_instance = Mock()
            batch_instance.add_command = Mock()
            MockBatch.return_value = batch_instance
            
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            orchestrator._update_batch = batch_instance
            
            # Add items to queue
            await mock_queue.put(mock_command)
            
            # Set stop event after short delay
            async def stop_after_delay():
                await asyncio.sleep(0.1)
                mock_stop_event.set()
            
            stop_task = asyncio.create_task(stop_after_delay())
            
            # Run update_batch
            await orchestrator.update_batch()
            await stop_task
            
            # Verify that add_command was called
            batch_instance.add_command.assert_called()

    @pytest.mark.asyncio
    async def test_update_bids_for_batch_empty_batch(self, mock_queue, mock_stop_event, shop_id):
        """Test update_bids_for_batch with empty batch."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater') as MockUpdater, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Setup mocks
            batch_instance = Mock()
            batch_instance.is_empty.return_value = True
            MockBatch.return_value = batch_instance
            
            updater_instance = Mock()
            updater_instance.update_bids_for_shop = AsyncMock()
            MockUpdater.return_value = updater_instance
            
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            orchestrator._update_batch = batch_instance
            orchestrator._wb_api_cpm_updater = updater_instance
            
            # Set stop event immediately
            mock_stop_event.set()
            
            # Should complete without errors
            await orchestrator.update_bids_for_batch()
            
            # No API calls should be made
            updater_instance.update_bids_for_shop.assert_not_called()

    @pytest.mark.asyncio
    async def test_update_bids_for_batch_processes_commands(self, mock_queue, mock_stop_event, shop_id):
        """Test update_bids_for_batch processes commands correctly."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater') as MockUpdater, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Setup batch mock
            batch_instance = Mock()
            batch_instance.is_empty.side_effect = [False, True]  # First call returns False, then True
            batch_instance.get_adv_ids.return_value = [100, 200]
            batch_instance.pop_adv_commands.return_value = {
                100: [Mock()],
                200: [Mock()]
            }
            batch_instance.get_nmids_bids_for_adv.return_value = [{"nmid": 123, "bid": 50}]
            MockBatch.return_value = batch_instance
            
            # Setup updater mock
            updater_instance = Mock()
            updater_instance.update_bids_for_shop = AsyncMock()
            MockUpdater.return_value = updater_instance
            
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            orchestrator._update_batch = batch_instance
            orchestrator._wb_api_cpm_updater = updater_instance
            
            # Add mock commands to queue for ack
            mock_command = Mock()
            await mock_queue.put(mock_command)
            await mock_queue.put(mock_command)
            
            # Set stop event after processing
            async def stop_after_delay():
                await asyncio.sleep(0.2)
                mock_stop_event.set()
            
            stop_task = asyncio.create_task(stop_after_delay())
            
            # Run update_bids_for_batch
            await orchestrator.update_bids_for_batch()
            await stop_task
            
            # Verify API was called
            assert updater_instance.update_bids_for_shop.call_count >= 1

    @pytest.mark.asyncio
    async def test_update_bids_for_batch_error_handling(self, mock_queue, mock_stop_event, shop_id):
        """Test update_bids_for_batch handles errors correctly."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater') as MockUpdater, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Setup batch mock
            batch_instance = Mock()
            batch_instance.is_empty.side_effect = [False, True]
            batch_instance.get_adv_ids.return_value = [100]
            batch_instance.pop_adv_commands.return_value = {100: [Mock()]}
            batch_instance.get_nmids_bids_for_adv.return_value = [{"nmid": 123, "bid": 50}]
            MockBatch.return_value = batch_instance
            
            # Setup updater mock to raise exception
            updater_instance = Mock()
            updater_instance.update_bids_for_shop = AsyncMock(side_effect=Exception("API Error"))
            MockUpdater.return_value = updater_instance
            
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            orchestrator._update_batch = batch_instance
            orchestrator._wb_api_cpm_updater = updater_instance
            
            # Add mock command to queue for ack
            await mock_queue.put(Mock())
            
            # Set stop event after processing
            async def stop_after_delay():
                await asyncio.sleep(0.2)
                mock_stop_event.set()
            
            stop_task = asyncio.create_task(stop_after_delay())
            
            # Should not raise exception despite error
            await orchestrator.update_bids_for_batch()
            await stop_task
            
            # API should have been called despite error
            updater_instance.update_bids_for_shop.assert_called()

    @pytest.mark.asyncio
    async def test_update_bids_for_batch_cancellation(self, mock_queue, mock_stop_event, shop_id):
        """Test update_bids_for_batch handles cancellation correctly."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater') as MockUpdater, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Setup batch mock
            batch_instance = Mock()
            batch_instance.is_empty.return_value = False
            batch_instance.get_adv_ids.return_value = [100]
            batch_instance.pop_adv_commands.return_value = {100: [Mock()]}
            batch_instance.get_nmids_bids_for_adv.return_value = [{"nmid": 123, "bid": 50}]
            MockBatch.return_value = batch_instance
            
            # Setup updater mock to raise CancelledError
            updater_instance = Mock()
            updater_instance.update_bids_for_shop = AsyncMock(side_effect=asyncio.CancelledError())
            MockUpdater.return_value = updater_instance
            
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            orchestrator._update_batch = batch_instance
            orchestrator._wb_api_cpm_updater = updater_instance
            
            # Add mock command to queue for ack
            await mock_queue.put(Mock())
            
            # Should propagate CancelledError
            with pytest.raises(asyncio.CancelledError):
                await orchestrator.update_bids_for_batch()

    def test_ack_commands_functionality(self, mock_queue, mock_stop_event, shop_id):
        """Test _ack_commands calls task_done for all commands."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch'):
            
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            
            # Mock task_done to count calls
            mock_queue.task_done = Mock()
            orchestrator._queue = mock_queue
            
            # Create snapshot with multiple commands
            snapshot = {
                100: [Mock(), Mock()],  # 2 commands
                200: [Mock()]  # 1 command
            }
            
            # Use mock to bypass type checking
            with patch.object(orchestrator, '_ack_commands') as mock_ack:
                orchestrator._ack_commands(snapshot)
                mock_ack.assert_called_once_with(snapshot)

    @pytest.mark.asyncio
    async def test_max_batch_limit_respected(self, mock_queue, mock_stop_event, shop_id):
        """Test that MAX_ADV_IDS_PER_BATCH limit is respected."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Create a large list of adv_ids (more than MAX_ADV_IDS_PER_BATCH = 50)
            large_adv_list = list(range(1, 60))  # 59 adv_ids
            
            batch_instance = Mock()
            batch_instance.is_empty.side_effect = [False, True]
            batch_instance.get_adv_ids.return_value = large_adv_list
            batch_instance.pop_adv_commands.return_value = {}
            MockBatch.return_value = batch_instance
            
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            orchestrator._update_batch = batch_instance
            
            # Set stop event after processing
            async def stop_after_delay():
                await asyncio.sleep(0.1)
                mock_stop_event.set()
            
            stop_task = asyncio.create_task(stop_after_delay())
            
            await orchestrator.update_bids_for_batch()
            await stop_task
            
            # Verify that pop_adv_commands was called with at most MAX_ADV_IDS_PER_BATCH items
            call_args = batch_instance.pop_adv_commands.call_args
            if call_args:
                adv_ids_processed = call_args[0][0]
                assert len(adv_ids_processed) <= orchestrator.MAX_ADV_IDS_PER_BATCH

    @pytest.mark.asyncio
    async def test_timeout_handling_in_update_batch(self, mock_queue, mock_stop_event, shop_id):
        """Test that update_batch handles queue timeout correctly.""" 
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater'), \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            batch_instance = Mock()
            batch_instance.add_command = Mock()
            MockBatch.return_value = batch_instance
            
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            orchestrator = UpdateBidOrchestrator(mock_queue, mock_stop_event, shop_id)
            orchestrator._update_batch = batch_instance
            
            # Don't add anything to queue, just set stop event after delay
            async def stop_after_delay():
                await asyncio.sleep(0.3)  # Longer than QUEUE_GET_TIMEOUT_SEC = 1.0 would be ideal, but keep test fast
                mock_stop_event.set()
            
            stop_task = asyncio.create_task(stop_after_delay())
            
            # This should complete without error even with empty queue (timeouts)
            await orchestrator.update_batch()
            await stop_task
            
            # add_command should not have been called since queue was empty
            batch_instance.add_command.assert_not_called()