    @pytest.mark.asyncio
    async def test_batch_size_limits(self):
        """Test that batch size limits are respected."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager') as MockCpm, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater') as MockUpdater, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Configure mocks
            MockCpm.return_value = TestNewCpmBidManagerMock()
            MockUpdater.return_value = TestWBApiCpmUpdaterMock("test_shop")
            MockBatch.return_value = TestUpdateBatchMock()
            
            # Import after mocking
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            queue = asyncio.Queue()
            stop_event = asyncio.Event()
            orchestrator = UpdateBidOrchestrator(queue, stop_event, "test_shop")
            
            # Create more than MAX_ADV_IDS_PER_BATCH commands
            large_batch = TestUpdateBatchMock()
            for adv_id in range(1, 60):  # 59 different adv_ids > 50 limit
                cmd = TestBidUpdateForNmidCommand(adv_id, 123, 50)
                large_batch.add_command(cmd)
            
            # Test that get_adv_ids can be sliced properly
            all_adv_ids = large_batch.get_adv_ids()
            assert len(all_adv_ids) == 59
            
            # Test slicing to MAX_ADV_IDS_PER_BATCH
            limited_adv_ids = all_adv_ids[:orchestrator.MAX_ADV_IDS_PER_BATCH]
            assert len(limited_adv_ids) == 50

    def test_ack_commands_logic(self):
        """Test _ack_commands method logic."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager') as MockCpm, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater') as MockUpdater, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Configure mocks
            MockCpm.return_value = TestNewCpmBidManagerMock()
            MockUpdater.return_value = TestWBApiCpmUpdaterMock("test_shop")
            MockBatch.return_value = TestUpdateBatchMock()
            
            # Import after mocking
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            queue = Mock()
            queue.task_done = Mock()
            stop_event = asyncio.Event()
            orchestrator = UpdateBidOrchestrator(queue, stop_event, "test_shop")
            orchestrator._queue = queue
            
            # Create test snapshot
            snapshot = {
                100: [
                    TestBidUpdateForNmidCommand(100, 123, 50),
                    TestBidUpdateForNmidCommand(100, 456, 75)
                ],
                200: [
                    TestBidUpdateForNmidCommand(200, 789, 25)
                ]
            }
            
            # Execute
            orchestrator._ack_commands(snapshot)
            
            # Verify task_done called for each command (3 total)
            assert queue.task_done.call_count == 3

    @pytest.mark.asyncio
