        """Test error handling in update_bids_for_batch."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager') as MockCpm, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater') as MockUpdater, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Configure mocks - updater raises exception
            mock_batch = TestUpdateBatchMock()
            mock_batch.add_command(TestBidUpdateForNmidCommand(100, 123, 50))
            
            mock_updater = TestWBApiCpmUpdaterMock("test_shop")
            mock_updater.update_bids_for_shop = AsyncMock(side_effect=Exception("API Error"))
            
            MockCpm.return_value = TestNewCpmBidManagerMock()
            MockUpdater.return_value = mock_updater
            MockBatch.return_value = mock_batch
            
            # Import after mocking
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            queue = asyncio.Queue()
            stop_event = asyncio.Event()
            orchestrator = UpdateBidOrchestrator(queue, stop_event, "test_shop")
            
            # Add mock command for ack
            await queue.put(TestBidUpdateForNmidCommand(100, 123, 50))
            
            # Set stop event after processing
            async def stop_after_delay():
                await asyncio.sleep(0.2)
                stop_event.set()
            
            stop_task = asyncio.create_task(stop_after_delay())
            
            # Should not raise exception despite API error
            await orchestrator.update_bids_for_batch()
            await stop_task

    def test_command_validation_mock(self):
        """Test command validation using mocks."""
        # Test valid command
        cmd = TestBidUpdateForNmidCommand(100, 123, 50)
        assert cmd.adv_id == 100
        assert cmd.nmid == 123
        assert cmd.new_bid == 50
        
        # Test send command
        send_cmd = TestSendToQueueForUpdateNmidBidCommand(100, 123, 100)
        assert send_cmd.adv_id == 100
        assert send_cmd.nmid == 123
        assert send_cmd.max_cpm_bid == 100

    @pytest.mark.asyncio
    async def test_timeout_scenarios(self):
        """Test timeout handling scenarios."""
        with patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.NewCpmBidManager') as MockCpm, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.WBApiCpmUpdater') as MockUpdater, \
             patch('app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator.UpdateBatch') as MockBatch:
            
            # Configure mocks
            MockCpm.return_value = TestNewCpmBidManagerMock()
            MockUpdater.return_value = TestWBApiCpmUpdaterMock("test_shop")
            MockBatch.return_value = TestUpdateBatchMock()
            
            # Import after mocking
            from app.modules.shop_runner.service_manager.services.update_cpm.update_bid_orchestrator import UpdateBidOrchestrator
            
            queue = asyncio.Queue()  # Empty queue will cause timeouts
            stop_event = asyncio.Event()
            orchestrator = UpdateBidOrchestrator(queue, stop_event, "test_shop")
            
            # Set stop event after delay to test timeout handling
            async def stop_after_delay():
                await asyncio.sleep(0.3)  # Longer than QUEUE_GET_TIMEOUT_SEC
                stop_event.set()
            
            stop_task = asyncio.create_task(stop_after_delay())
            
            # Should handle timeouts gracefully
            await orchestrator.update_batch()
            await stop_task

    def test_mock_integration(self):
        """Test that all mocks integrate properly."""
        # Test NewCpmBidManager mock
        cpm_manager = TestNewCpmBidManagerMock()
        assert hasattr(cpm_manager, 'get_new_cmp_bid')
        assert len(cpm_manager.call_history) == 0
        
        # Test WBApiCpmUpdater mock
        updater = TestWBApiCpmUpdaterMock("test_shop")
        assert updater.shop_id == "test_shop"
        assert hasattr(updater, 'update_bids_for_shop')
        assert len(updater.call_history) == 0
        
        # Test UpdateBatch mock
        batch = TestUpdateBatchMock()
        assert batch.is_empty()
        assert hasattr(batch, 'add_command')
        assert hasattr(batch, 'get_nmids_bids_for_adv')
        assert hasattr(batch, 'pop_adv_commands')

    def test_comprehensive_workflow_mock(self):
        """Test comprehensive workflow using only mocks."""
        # Create all mocks
        cpm_manager = TestNewCpmBidManagerMock()
        updater = TestWBApiCpmUpdaterMock("test_shop")
        batch = TestUpdateBatchMock()
        
        # Simulate workflow
        # 1. Create command
        send_command = TestSendToQueueForUpdateNmidBidCommand(100, 123, 100)
        
        # 2. Get new bid
        new_bid = 75  # Mock return value
        
        # 3. Create bid update command
        bid_command = TestBidUpdateForNmidCommand(100, 123, new_bid)
        
        # 4. Add to batch
        batch.add_command(bid_command)
        
        # 5. Process batch
        assert not batch.is_empty()
        adv_ids = batch.get_adv_ids()
        assert adv_ids == [100]
        
        # 6. Get bids for processing
        nmids_bids = batch.get_nmids_bids_for_adv(100)
        assert nmids_bids == [{"nmid": 123, "bid": 75}]
        
        # Verify complete workflow
        assert len(batch.commands) == 1
        assert batch.commands[100][0] is bid_command