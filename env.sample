# Локальная разработка: канон = публичный IP + NodePort
# (см. k8s/network/local-dev-external-access.md, scripts/sync-local-env-from-k8s.ps1).
# In-app / scripts kubectl port-forward (k8s_tunnels, dev-tunnels.ps1) удалены.
# RUN_LOCAL — legacy-флаг; на подключение к БД не влияет.
RUN_LOCAL=false
# Destructive / integration tests: DEV_TUNNELS_ENABLED must be false/unset
# (fail-closed denylist; также unset DEV_TUNNEL_* / DEV_TUNNELS_KUBECONFIG).
DEV_TUNNELS_ENABLED=false
# Внешний PG: NodePort pooler на worker IP (НЕ LB 217.x — Timeweb Proxy ломает auth):
# POSTGRES_MASTER_HOST=<worker ExternalIP>
# POSTGRES_REPLICA_HOST=<worker ExternalIP>
# POSTGRES_PORT=31024
# POSTGRES_SSL_MODE=require
# Внешний CH: NodePort http на worker IP (см. kubectl get svc clickhouse-external):
# CLICK_HOUSE_HOST=<worker ExternalIP>
# CLICK_HOUSE_USER=adv_bot_user
# CLICK_HOUSE_PASSWORD=<из secret common-secrets, см. scripts/sync-local-env-from-k8s.ps1>
# CLICKHOUSE_PORT=8123

# =============================================================================
# Лимиты параллельных ЗАПРОСОВ к ресурсам (shop-runner, updater, warmup)
# Один семафор на PG и один на CH на event loop — см. app/utils/resource_limits.py
# =============================================================================
POSTGRES_QUERY_CONCURRENCY=10              # макс. одновременных PG-сессий (get_async_session_maker)
CLICKHOUSE_QUERY_CONCURRENCY=2             # макс. одновременных CH-запросов (run_ch_with_timeout / anti_ch_crash_semaphore)
CLICKHOUSE_QUERY_ACQUIRE_TIMEOUT_SEC=120   # ждать слот CH (сек), иначе TimeoutError
CLICKHOUSE_QUERY_TIMEOUT_SEC=900           # таймаут одного CH-запроса после acquire (сек)
REDIS_QUERY_CONCURRENCY=8                  # snapshot collector: параллельные Redis batch (min_bids)
# Legacy (если POSTGRES_QUERY_CONCURRENCY не задан):
# COUNT_SEMAPHORE_TO_POSTGRES=10

# Shop-runner: нет обязательных данных в Redis/snapshot — warning + пауза в while_coroutine_decorator
SHOP_RUNNER_REQUIRED_DATA_MISS_RETRY_SEC=60      # сек до повтора корутины (ожидание snapshot warmup)
SHOP_RUNNER_REQUIRED_DATA_MISS_MAX_ATTEMPTS=30   # подряд miss без успеха → re-raise (0 = без лимита)
# Legacy: SHOP_RUNNER_KEYWORDS_CACHE_MISS_RETRY_SEC (fallback для RETRY_SEC)

# --- Postgres connection settings ---
POSTGRES_MASTER_HOST=postgres-db-0.postgres-db.prod-adv-bot.svc.cluster.local
POSTGRES_REPLICA_HOST=postgres-db-0.postgres-db.prod-adv-bot.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DBNAME=adv_updater
POSTGRES_USER=advupdater
# POSTGRES_PASSWORD=<secret advupdater.postgres-db.credentials... или sync-local-env-from-k8s.ps1>
POSTGRES_PASSWORD=changeme

# SSL
POSTGRES_SSL_CA=/etc/ssl/certs/postgres_ca.pem
POSTGRES_SSL_INSECURE=true

# Redis — только локальный инстанс (не k8s redis-master / redis2-master)
REDIS_HOST=127.0.0.1
REDIS_MASTER_HOST=127.0.0.1
REDIS_REPLICA_HOST=127.0.0.1
REDIS_PORT=6379
# Запуск (dev/app local): Docker Desktop -> docker run -d --name adv-bot-redis -p 6379:6379 redis:7-alpine
# Test compose (/opsx-test-env UP → tests/docker-compose.test.yml test_redis):
#   host publish 6390:6379 — never bind host 6379 from that compose.
#   For pytest /opsx-static-check FULL against that Redis: REDIS_PORT=6390
#   (default 6379 above is a different process / out of test-compose scope).

# =============================================================================
# Free-bot entry (invite deferred — prod path: channel + phone only)
# =============================================================================
# Defaults in code: INVITE_GATE=false, PRESENTATION_ONLY_MODE=false (intentional
# flip vs legacy stage where both were true when env empty).
# DO NOT set INVITE_GATE=true / PRESENTATION_ONLY_MODE=true on stage/prod until
# invite rollout owner GO (see openspec/changes/add-free-ui-bot-access-guards/
# decisions/invite-gate-deferred/decision.md).
# GateMiddleware is registered but no-op while invite_gate is off; bugbot findings
# in invite-only branches below L137 are dormant / not prod defects.
#
# INVITE_GATE=false
# PRESENTATION_ONLY_MODE=false
# --- re-enable later (explicit owner GO only) ---
# INVITE_GATE=true
# PRESENTATION_ONLY_MODE=true
# EXTRA_ADMIN_TELEGRAM_IDS=123456789,987654321  # доп. админы (опционально)
# PRESENTATION_NOTIFY_TELEGRAM_ID=373435337  # кому слать заявку на презентацию (по умолчанию главный менеджер)

# New WBCabinet.default_max_cpm when env unset (code default 5000; legacy stage was 10000):
# DEFAULT_MAX_CPM=5000

# Telegram bot secrets.
# Для рабочего клиентского бота лучше использовать отдельные secret env:
# CLIENT_BOT_TOKEN=<telegram bot token>
# CLIENT_BOT_WEBHOOK_SECRET=<telegram webhook secret>
# Legacy fallback для старых деплоев:
# TELEGRAM_BOT_TOKEN=<telegram bot token>
# WEBHOOK_SECRET=<telegram webhook secret>
# Пул токенов для исходящих уведомлений:
# TG_SENDER_BOT_TOKENS=<token1>,<token2>   # secret-oriented alias (preferred)
# TG_TOKENS_FOR_SENDING=<token1>,<token2>   # legacy shared env name

# Payments secret.
# YOOKASSA_TOKEN=<yookassa token>

# Unisender Go / email HTTP (no SMTP in app)
# UNISENDER_GO_API_KEY=   # scrubbed in pytest conftest; never use prod key in tests
# UNISENDER_GO_API_BASE=https://goapi.unisender.ru/ru/transactional/api/v1
# UNISENDER_GO_REQUEST_TIMEOUT_SEC=30
# UNISENDER_GO_DEFAULT_FROM_EMAIL=
# UNISENDER_GO_DEFAULT_GLOBAL_LANGUAGE=ru
# UNISENDER_GO_INTEGRATION_TEST_RECIPIENT=  # только для tests/integration (реальная отправка)

# =============================================================================
# Destructive integration tests (PG / ClickHouse) — fail-closed allowlist
# =============================================================================
# Marker: pytest -m destructive_local  (NOT selected by -m fast / -m integration)
# Host: localhost|127.0.0.1
# PG Port: 5433  Database: test_adv_bot_db
# CH HTTP Port: 8124  Database: test_adv_bot_clickhouse  (NOT default_db)
# TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_password@127.0.0.1:5433/test_adv_bot_db
# ALLOW_DESTRUCTIVE_TEST_DB=1
# ALLOW_DESTRUCTIVE_TEST_CLICKHOUSE=1
# DEV_TUNNELS_ENABLED must be false/unset; unset DEV_TUNNEL_* / DEV_TUNNELS_KUBECONFIG
# Without opt-in fixtures refuse connect before create_engine / get_async_client.
# Fixtures also require @pytest.mark.destructive_local on the test (env alone is not enough).
# Forbid any pre-existing SSH/kubectl port-forward onto 5433/8124/9001 before destructive runs.
# Pytest session: outbound TCP вне loopback + curl/wget/shell-wrap/port-forward blocked
# (tests/support/network_guard.py, subprocess_guard.py).
# Residual risk: published host ports in tests/docker-compose.test.yml — prefer
# internal Compose network without host publish (requires separate authorization).

# Updater (python updater.py → run_main_coroutines): Telegram-уведомления пользователям
# BALANCE_EXPIRATION_INFORMER_ENABLED=true   # false — баланс (D1/D3/минус) и просроченные токены

# Локальный prod-стек (зеркало k8s prod-adv-bot): poetry run python run_adv_bot_stack.py
# Сервисы: active_shop_ids → shop_worker → updater, client_bot, arq_worker (--list для списка)

# Shop-runner: фильтрация магазинов при постановке (new_wb_shop_update_run, воркеры + run_update_active_shop_ids)
# SHOP_FILTER_LIST=shop_a,shop_b  # whitelist — только эти shop_id (PG active_shops, воркер, snapshot tick)
# SHOP_EXCLUDE_LIST=shop_c      # blacklist — исключить (то же на всех путях)
# COROUTINE_PHASE_TRACE_ADV_IDS=32824944  # тайминги: update_cluster_bids, single_run (при включённом env)
# В логах: Select-String "[coroutine_timing]" | Select-String "32824944|db28efff"
# DEBUG_CLUSTER_BID_TRACE=1  # пошаговый trace update_cluster_bids только для exact ids/key (no-op если !=1)
# DEBUG_CLUSTER_BID_TRACE_SHOP_ID=db28efff-f7a9-52f8-8342-f1a58f7d8ed3
# DEBUG_CLUSTER_BID_TRACE_ADV_ID=32824944
# DEBUG_CLUSTER_BID_TRACE_SEARCH_ADV_ID=29734515
# DEBUG_CLUSTER_BID_TRACE_NMID=10749810
# DEBUG_CLUSTER_BID_TRACE_KS_ID=17783715
# DEBUG_CLUSTER_BID_TRACE_KEY=антивозрастной матирующий крем
# В логах: Select-String "[cluster_bid_trace]"
# STATS_FRESHNESS_GUARD_ENABLED=true  # false — не фильтровать РК по свежести статы в корутинах

# A/B Hold epoch-managed flow (fail-closed; spec card-ab-hold-mode §25 / OD-05)
# Broad enable for all paid requires OD-05: see openspec/changes/card-ab-hold-mode/rollout/od05-readiness.md
# CARD_AB_HOLD_EPOCH_FLOW_ENABLED=false
# CARD_AB_HOLD_EPOCH_ALLOWLIST_ADV_IDS=
# CARD_AB_HOLD_EPOCH_ALLOWLIST_SHOP_IDS=
# CARD_AB_HOLD_OD05_BROAD_ENABLE_ACCEPTED=false

# WB PROMOTION HTTP: process-wide лимит in-flight (см. promotion_http_concurrency.py)
# PROMOTION_HTTP_CONCURRENCY_LIMIT=80

# =============================================================================
# Snapshot data updater — python updater.py / cli daemon
# Документация: docks/snapshot_data_updater.md
# Порядок prod: active_shops (Redis) → updater (live) → shop-runner
# PG/CH лимиты — блок «Лимиты параллельных ЗАПРОСОВ» выше (не SNAPSHOT_*_CONCURRENCY).
# =============================================================================

SNAPSHOT_UPDATER_USE_LIVE=1                                    # 1=live PG+Redis+CH+warmup+запись snapshot; 0=stub
SNAPSHOT_REFRESH_INTERVAL_SEC=200                              # интервал global tick (сек)
SNAPSHOT_TICK_POLICY=skip                                      # skip|wait — пересечение global tick
SNAPSHOT_RESOURCE_TASK_TIMEOUT_SEC=360                         # ResourceQueue Redis: min_bids/keywords в collector (сек)
# SNAPSHOT_PG_TASK_TIMEOUT_SEC=360                             # зарезерв., PG не через ResourceQueue — POSTGRES_QUERY_CONCURRENCY
SNAPSHOT_REDIS_TTL_SEC=3600                                    # TTL adv_snapshot:v1:* в Redis (сек)
SNAPSHOT_SCHEMA_VERSION=1                                      # версия DTO snapshot
SNAPSHOT_KEYWORDS_STRICT_FRESHNESS=1                           # 1=нет meta у hash → пересчёт keywords
SNAPSHOT_KEYWORDS_SKIP_REFRESH_SEC=300                         # keywords моложе N с → без get_good_bad_phrases
SNAPSHOT_KEYWORDS_STALE_SEC=900                                # keywords старше N с → CacheStaleError при read
# TTL hash calculated_keywords:{adv_id} (сек); default = max(STALE,300)*4 — см. CALCULATED_KEYWORDS_REDIS_TTL_SEC
# CALCULATED_KEYWORDS_REDIS_TTL_SEC=3600
SNAPSHOT_ADV_SKIP_REFRESH_SEC=300                              # snapshot adv: окно «не протух» для skip
SNAPSHOT_ADV_STALE_SEC=900                                     # snapshot adv старше N с → CacheStaleError при read
SNAPSHOT_SHOP_SKIP_REFRESH_SEC=280                             # shop batch моложе N с → не запускать collect
SNAPSHOT_PLAN_FACT_SKIP_REFRESH_SEC=300                        # plan/fact skip (сек), зарезерв. в collector
SNAPSHOT_PLAN_FACT_STALE_SEC=900                               # plan/fact stale (сек), зарезерв.
SNAPSHOT_CLUSTER_TEXTS_SKIP_REFRESH_SEC=300                    # cluster texts skip (сек), зарезерв.
SNAPSHOT_CLUSTER_TEXTS_STALE_SEC=900                           # cluster texts stale (сек), зарезерв.
SNAPSHOT_MIN_BIDS_SKIP_REFRESH_SEC=300                         # min bids skip (сек), зарезерв.
SNAPSHOT_MIN_BIDS_STALE_SEC=900                                # min bids stale (сек), зарезерв.
# Fallback мин. CPM (руб.) при cache miss на путях расчёта/UI (не в refresh/backfill)
# Пустой env → встроенный default: auto 100, search 300 (см. settings_master.MIN_BID_*)
MIN_BID_AUTO_DEFAULT=100                                       # авто/полки
MIN_BID_SEARCH_DEFAULT=300                                     # поиск/аукцион, cluster bids
# Логи min_bids cache miss (read_min_bids_cache_only): WARNING, не ERROR — см. docks/snapshot_data_updater.md
SNAPSHOT_CLUSTER_BIDS_SHADOW=1                                 # shadow: логи keywords в update_cluster_bids
SNAPSHOT_CLUSTER_BIDS_READ=0                                   # 1=read snapshot; 0=Redis cache_only
SNAPSHOT_WB_ADV_DTO_SHADOW=1                                   # shadow: логи в get_wb_advs_dto path
SNAPSHOT_WB_ADV_DTO_READ=0                                     # 1=read snapshot; 0=только Redis keywords

# =============================================================================
# V3 auto-updater: профиль позиций для M/O/C
# =============================================================================
# INCLUDE_SYNTHETIC_POSITION_PROFILE=true                        # default true: синтетика _fill_positions в M/O/C; false — только bid_decision_log buckets

# V3 preamble: pay_for_order gap enable / pfo_off (зона «1 от MAX плана» = ratio × plan.max_pay_for_order)
# V3_PAY_FOR_ORDER_GAP_ENABLE_PLAN_HEADROOM_RATIO=1              # skip enable при fact >= ratio×plan.max (default 1 = plan.max)
# V3_PAY_FOR_ORDER_OFF_PLAN_HEADROOM_RATIO=1                     # OFF ключей PFO>max при fact >= ratio×plan.max (default 1)
