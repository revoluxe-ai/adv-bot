# Postgres connection settings
POSTGRES_MASTER_HOST=postgres-db-0.postgres-db.prod-adv-bot.svc.cluster.local
POSTGRES_REPLICA_HOST=postgres-db-0.postgres-db.prod-adv-bot.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DBNAME=adv_updater
POSTGRES_USER=advupdater
POSTGRES_PASSWORD=changeme

# SSL
POSTGRES_SSL_CA=/etc/ssl/certs/postgres_ca.pem
POSTGRES_SSL_INSECURE=true

# INVITE_GATE=false  # только если нужен бот без гейта по инвайту (по умолчанию: true)
# PRESENTATION_ONLY_MODE=false  # полный функционал бота (по умолчанию: true — только презентация)
# EXTRA_ADMIN_TELEGRAM_IDS=123456789,987654321  # доп. админы (опционально)
# PRESENTATION_NOTIFY_TELEGRAM_ID=373435337  # кому слать заявку на презентацию (по умолчанию главный менеджер)

# Unisender Go (transactional Web API, email/send.json)
# UNISENDER_GO_API_KEY=
# UNISENDER_GO_API_BASE=https://goapi.unisender.ru/ru/transactional/api/v1
# UNISENDER_GO_REQUEST_TIMEOUT_SEC=30
# UNISENDER_GO_DEFAULT_FROM_EMAIL=
# UNISENDER_GO_DEFAULT_GLOBAL_LANGUAGE=ru
# UNISENDER_GO_INTEGRATION_TEST_RECIPIENT=  # только для tests/integration (реальная отправка)

