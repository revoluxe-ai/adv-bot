# Локальная разработка по публичному IP: k8s/network/local-dev-external-access.md
# RUN_LOCAL — legacy-флаг, port-forward из приложения не поднимается
RUN_LOCAL=false
# Опционально kubectl port-forward (scripts/dev-tunnels.ps1 или k8s_tunnels вручную):
# DEV_TUNNELS_ENABLED=true
# Внешний PG: NodePort pooler на worker IP (НЕ LB 217.x — Timeweb Proxy ломает auth):
# POSTGRES_MASTER_HOST=<worker ExternalIP>
# POSTGRES_REPLICA_HOST=<worker ExternalIP>
# POSTGRES_PORT=31024
# POSTGRES_SSL_MODE=require
# Внешний CH: NodePort http на worker IP (см. kubectl get svc clickhouse-external):
# CLICK_HOUSE_HOST=<worker ExternalIP>
# CLICK_HOUSE_USER=adv_bot_user
# CLICK_HOUSE_PASSWORD=<из secret common-secrets, см. scripts/sync-local-env-from-k8s.ps1>
# CLICKHOUSE_PORT=8123
# DEV_TUNNELS_KUBECONFIG=k8s/new-cluster/new-cluster-config.yaml
# По умолчанию локальный PG идёт через PgBouncer session mode:
DEV_TUNNEL_PG_RESOURCE=svc/postgres-db-pooler
# Для аварийной диагностики direct Postgres (не default):
# DEV_TUNNEL_PG_RESOURCE=pod/postgres-db-0
# DEV_TUNNEL_PG_SMOKE_STRICT=false  # true: падать, если SELECT 1 через туннель не прошел
# DEV_TUNNEL_READY_TIMEOUT_SEC=90

# =============================================================================
# Лимиты параллельных ЗАПРОСОВ к ресурсам (shop-runner, updater, warmup)
# Один семафор на PG и один на CH на event loop — см. app/utils/resource_limits.py
# =============================================================================
POSTGRES_QUERY_CONCURRENCY=10              # макс. одновременных PG-сессий (get_async_session_maker)
CLICKHOUSE_QUERY_CONCURRENCY=2             # макс. одновременных CH-запросов (run_ch_with_timeout / anti_ch_crash_semaphore)
CLICKHOUSE_QUERY_ACQUIRE_TIMEOUT_SEC=120   # ждать слот CH (сек), иначе TimeoutError
CLICKHOUSE_QUERY_TIMEOUT_SEC=900           # таймаут одного CH-запроса после acquire (сек)
REDIS_QUERY_CONCURRENCY=8                  # snapshot collector: параллельные Redis batch (min_bids)
# Legacy (если POSTGRES_QUERY_CONCURRENCY не задан):
# COUNT_SEMAPHORE_TO_POSTGRES=10

# Shop-runner: нет обязательных данных в Redis/snapshot — warning + пауза в while_coroutine_decorator
SHOP_RUNNER_REQUIRED_DATA_MISS_RETRY_SEC=60      # сек до повтора корутины (ожидание snapshot warmup)
SHOP_RUNNER_REQUIRED_DATA_MISS_MAX_ATTEMPTS=30   # подряд miss без успеха → re-raise (0 = без лимита)
# Legacy: SHOP_RUNNER_KEYWORDS_CACHE_MISS_RETRY_SEC (fallback для RETRY_SEC)

# --- Postgres connection settings ---
POSTGRES_MASTER_HOST=postgres-db-0.postgres-db.prod-adv-bot.svc.cluster.local
POSTGRES_REPLICA_HOST=postgres-db-0.postgres-db.prod-adv-bot.svc.cluster.local
POSTGRES_PORT=5432
# При DEV_TUNNELS_ENABLED + dev-tunnels.ps1 — localhost:
# POSTGRES_MASTER_HOST=127.0.0.1
# POSTGRES_REPLICA_HOST=127.0.0.1
# POSTGRES_PORT=15432
# CLICK_HOUSE_HOST=127.0.0.1
# CLICKHOUSE_PORT=18123
POSTGRES_DBNAME=adv_updater
POSTGRES_USER=advupdater
# POSTGRES_PASSWORD=<secret advupdater.postgres-db.credentials... или sync-local-env-from-k8s.ps1>
POSTGRES_PASSWORD=changeme

# SSL
POSTGRES_SSL_CA=/etc/ssl/certs/postgres_ca.pem
POSTGRES_SSL_INSECURE=true

# Redis — только локальный инстанс (не k8s redis-master / redis2-master)
REDIS_HOST=127.0.0.1
REDIS_MASTER_HOST=127.0.0.1
REDIS_REPLICA_HOST=127.0.0.1
REDIS_PORT=6379
# Запуск: Docker Desktop -> docker run -d --name adv-bot-redis -p 6379:6379 redis:7-alpine

# INVITE_GATE=false  # только если нужен бот без гейта по инвайту (по умолчанию: true)
# PRESENTATION_ONLY_MODE=false  # полный функционал бота (по умолчанию: true — только презентация)
# EXTRA_ADMIN_TELEGRAM_IDS=123456789,987654321  # доп. админы (опционально)
# PRESENTATION_NOTIFY_TELEGRAM_ID=373435337  # кому слать заявку на презентацию (по умолчанию главный менеджер)

# Unisender Go (transactional Web API, email/send.json)
# UNISENDER_GO_API_KEY=
# UNISENDER_GO_API_BASE=https://goapi.unisender.ru/ru/transactional/api/v1
# UNISENDER_GO_REQUEST_TIMEOUT_SEC=30
# UNISENDER_GO_DEFAULT_FROM_EMAIL=
# UNISENDER_GO_DEFAULT_GLOBAL_LANGUAGE=ru
# UNISENDER_GO_INTEGRATION_TEST_RECIPIENT=  # только для tests/integration (реальная отправка)

# Локальный prod-стек (зеркало k8s prod-adv-bot): poetry run python run_adv_bot_stack.py
# Сервисы: active_shop_ids → shop_worker → updater, client_bot, arq_worker (--list для списка)

# Shop-runner: фильтрация магазинов при постановке (new_wb_shop_update_run, воркеры + run_update_active_shop_ids)
# SHOP_FILTER_LIST=shop_a,shop_b  # whitelist — только эти shop_id (PG active_shops, воркер, snapshot tick)
# SHOP_EXCLUDE_LIST=shop_c      # blacklist — исключить (то же на всех путях)
# COROUTINE_PHASE_TRACE_ADV_IDS=32824944  # тайминги: process_adv_v3, update_cluster_bids, get_wb_advs_dto
# В логах: Select-String "[coroutine_timing]" | Select-String "32824944|db28efff"
# STATS_FRESHNESS_GUARD_ENABLED=true  # false — не фильтровать РК по свежести статы в корутинах

# WB PROMOTION HTTP: process-wide лимит in-flight (см. promotion_http_concurrency.py)
# PROMOTION_HTTP_CONCURRENCY_LIMIT=80

# =============================================================================
# Snapshot data updater — python updater.py / cli daemon
# Документация: docks/snapshot_data_updater.md
# Порядок prod: active_shops (Redis) → updater (live) → shop-runner
# PG/CH лимиты — блок «Лимиты параллельных ЗАПРОСОВ» выше (не SNAPSHOT_*_CONCURRENCY).
# =============================================================================

SNAPSHOT_UPDATER_USE_LIVE=1                                    # 1=live PG+Redis+CH+warmup+запись snapshot; 0=stub
SNAPSHOT_REFRESH_INTERVAL_SEC=200                              # интервал global tick (сек)
SNAPSHOT_TICK_POLICY=skip                                      # skip|wait — пересечение global tick
SNAPSHOT_RESOURCE_TASK_TIMEOUT_SEC=360                         # таймаут Redis-фаз collector (сек)
SNAPSHOT_PG_TASK_TIMEOUT_SEC=360                               # зарезерв.; PG лимит — POSTGRES_QUERY_CONCURRENCY
SNAPSHOT_REDIS_TTL_SEC=3600                                    # TTL adv_snapshot:v1:* в Redis (сек)
SNAPSHOT_SCHEMA_VERSION=1                                      # версия DTO snapshot
SNAPSHOT_KEYWORDS_STRICT_FRESHNESS=1                           # 1=нет meta у hash → пересчёт keywords
SNAPSHOT_KEYWORDS_SKIP_REFRESH_SEC=300                         # keywords моложе N с → без get_good_bad_phrases
SNAPSHOT_KEYWORDS_STALE_SEC=900                                # keywords старше N с → CacheStaleError при read
SNAPSHOT_ADV_SKIP_REFRESH_SEC=300                              # snapshot adv: окно «не протух» для skip
SNAPSHOT_ADV_STALE_SEC=900                                     # snapshot adv старше N с → CacheStaleError при read
SNAPSHOT_SHOP_SKIP_REFRESH_SEC=280                             # shop batch моложе N с → не запускать collect
SNAPSHOT_PLAN_FACT_SKIP_REFRESH_SEC=300                        # plan/fact skip (сек), зарезерв. в collector
SNAPSHOT_PLAN_FACT_STALE_SEC=900                               # plan/fact stale (сек), зарезерв.
SNAPSHOT_CLUSTER_TEXTS_SKIP_REFRESH_SEC=300                    # cluster texts skip (сек), зарезерв.
SNAPSHOT_CLUSTER_TEXTS_STALE_SEC=900                           # cluster texts stale (сек), зарезерв.
SNAPSHOT_MIN_BIDS_SKIP_REFRESH_SEC=300                         # min bids skip (сек), зарезерв.
SNAPSHOT_MIN_BIDS_STALE_SEC=900                                # min bids stale (сек), зарезерв.
SNAPSHOT_CLUSTER_BIDS_SHADOW=1                                 # shadow: логи keywords в update_cluster_bids
SNAPSHOT_CLUSTER_BIDS_READ=0                                   # 1=read snapshot; 0=Redis cache_only
SNAPSHOT_WB_ADV_DTO_SHADOW=1                                   # shadow: логи в get_wb_advs_dto path
SNAPSHOT_WB_ADV_DTO_READ=0                                     # 1=read snapshot; 0=только Redis keywords

