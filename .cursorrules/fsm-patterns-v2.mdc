# Правила работы с FSM в Aiogram

## Контекст применения
Эти правила используются при разработке диалоговых форм и многоэтапных процессов в Telegram-ботах с использованием Aiogram.

## Основные принципы
1. Использовать FSM для сохранения состояния между сообщениями
2. Группировать связанные состояния в один класс StatesGroup
3. Явно указывать переходы между состояниями
4. Обеспечивать возможность отмены процесса на любом этапе

## Создание и организация состояний

### Определение состояний
```python
from aiogram.fsm.state import State, StatesGroup

class RegistrationForm(StatesGroup):
    name = State()         # Состояние ожидания ввода имени
    phone = State()        # Состояние ожидания ввода телефона
    email = State()        # Состояние ожидания ввода email
    confirm = State()      # Состояние подтверждения данных
```

### Инициализация хранилища состояний
```python
from aiogram.fsm.storage.memory import MemoryStorage
from aiogram.fsm.storage.redis import RedisStorage

# Для разработки - хранилище в памяти
storage = MemoryStorage()

# Для продакшена - Redis хранилище
# storage = RedisStorage.from_url('redis://localhost:6379/0')

dp = Dispatcher(storage=storage)
```

## Управление состояниями

### Установка состояния
```python
from aiogram.fsm.context import FSMContext

@router.message(Command("register"))
async def cmd_register(message: Message, state: FSMContext):
    # Установка начального состояния
    await state.set_state(RegistrationForm.name)
    
    # Отправка сообщения с инструкциями
    await message.answer(
        "Начинаем регистрацию. Введите ваше имя:",
        reply_markup=ReplyKeyboardMarkup(
            keyboard=[[KeyboardButton(text="Отмена")]],
            resize_keyboard=True
        )
    )
```

### Обработка данных и переходы между состояниями
```python
@router.message(RegistrationForm.name)
async def process_name(message: Message, state: FSMContext):
    # Сохранение данных в хранилище состояний
    await state.update_data(name=message.text)
    
    # Переход к следующему состоянию
    await state.set_state(RegistrationForm.phone)
    
    await message.answer("Теперь введите ваш номер телефона:")
```

### Получение и использование данных
```python
@router.message(RegistrationForm.confirm)
async def process_confirm(message: Message, state: FSMContext):
    if message.text.lower() != "подтверждаю":
        await message.answer("Для подтверждения введите 'Подтверждаю'")
        return
    
    # Получение всех сохраненных данных
    data = await state.get_data()
    
    # Использование данных
    user = await user_service.create_user(
        name=data["name"],
        phone=data["phone"],
        email=data["email"]
    )
    
    # Очистка состояния после завершения процесса
    await state.clear()
    
    await message.answer(
        f"Регистрация успешно завершена! Ваш ID: {user.id}",
        reply_markup=ReplyKeyboardRemove()
    )
```

### Отмена процесса
```python
@router.message(Command("cancel"))
@router.message(F.text.lower() == "отмена")
async def cmd_cancel(message: Message, state: FSMContext):
    # Проверка, активно ли какое-либо состояние
    current_state = await state.get_state()
    if current_state is None:
        await message.answer("Нет активных процессов для отмены.")
        return
    
    # Очистка состояния
    await state.clear()
    
    await message.answer(
        "Процесс отменен.",
        reply_markup=ReplyKeyboardRemove()
    )
```

## Использование фильтров по состояниям

### Фильтрация обработчиков по состоянию
```python
from aiogram.filters import StateFilter

# Обработчик для конкретного состояния
@router.message(StateFilter(RegistrationForm.phone))
async def process_phone(message: Message, state: FSMContext):
    # Проверка формата телефона
    if not is_valid_phone(message.text):
        await message.answer("Неверный формат телефона. Попробуйте снова.")
        return
    
    await state.update_data(phone=message.text)
    await state.set_state(RegistrationForm.email)
    await message.answer("Теперь введите ваш email:")

# Обработчик для нескольких состояний
@router.message(
    StateFilter(RegistrationForm.name, RegistrationForm.email),
    F.text.lower() == "помощь"
)
async def process_help_in_form(message: Message, state: FSMContext):
    current_state = await state.get_state()
    
    if current_state == RegistrationForm.name:
        await message.answer("Введите ваше полное имя, например: Иван Петров")
    elif current_state == RegistrationForm.email:
        await message.answer("Введите ваш email в формате user@example.com")
```

## Типичные ошибки
- Забывать очищать состояние после завершения диалога
- Не предусматривать возможность отмены процесса
- Смешивать состояния из разных процессов
- Не сохранять промежуточные данные в хранилище состояний

## Пример полного диалога
```python
from aiogram import Router, F
from aiogram.filters import Command, StateFilter
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.types import Message, ReplyKeyboardMarkup, KeyboardButton, ReplyKeyboardRemove

class OrderFood(StatesGroup):
    dish = State()
    size = State()
    address = State()
    confirm = State()

router = Router()

@router.message(Command("order"))
async def cmd_order(message: Message, state: FSMContext):
    await state.set_state(OrderFood.dish)
    kb = ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="Пицца"), KeyboardButton(text="Суши")],
            [KeyboardButton(text="Отмена")]
        ],
        resize_keyboard=True
    )
    await message.answer("Что вы хотите заказать?", reply_markup=kb)

@router.message(OrderFood.dish)
async def process_dish(message: Message, state: FSMContext):
    if message.text not in ["Пицца", "Суши"]:
        await message.answer("Пожалуйста, выберите блюдо из меню.")
        return
    
    await state.update_data(dish=message.text)
    await state.set_state(OrderFood.size)
    
    kb = ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="Маленькая"), KeyboardButton(text="Средняя"), KeyboardButton(text="Большая")],
            [KeyboardButton(text="Отмена")]
        ],
        resize_keyboard=True
    )
    await message.answer("Выберите размер:", reply_markup=kb)

@router.message(OrderFood.size)
async def process_size(message: Message, state: FSMContext):
    if message.text not in ["Маленькая", "Средняя", "Большая"]:
        await message.answer("Пожалуйста, выберите размер из меню.")
        return
    
    await state.update_data(size=message.text)
    await state.set_state(OrderFood.address)
    
    await message.answer(
        "Укажите адрес доставки:",
        reply_markup=ReplyKeyboardMarkup(
            keyboard=[[KeyboardButton(text="Отмена")]],
            resize_keyboard=True
        )
    )

@router.message(OrderFood.address)
async def process_address(message: Message, state: FSMContext):
    await state.update_data(address=message.text)
    
    # Получение данных и формирование сообщения подтверждения
    data = await state.get_data()
    order_info = (
        f"Проверьте ваш заказ:\n"
        f"Блюдо: {data['dish']}\n"
        f"Размер: {data['size']}\n"
        f"Адрес: {data['address']}\n\n"
        f"Для подтверждения введите 'Подтверждаю'"
    )
    
    await state.set_state(OrderFood.confirm)
    
    kb = ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="Подтверждаю")],
            [KeyboardButton(text="Отмена")]
        ],
        resize_keyboard=True
    )
    await message.answer(order_info, reply_markup=kb)

@router.message(OrderFood.confirm)
async def process_confirm(message: Message, state: FSMContext):
    if message.text != "Подтверждаю":
        await message.answer("Для подтверждения нажмите кнопку 'Подтверждаю'")
        return
    
    data = await state.get_data()
    
    # Здесь должна быть логика создания заказа
    order_id = await order_service.create_order(
        user_id=message.from_user.id,
        dish=data["dish"],
        size=data["size"],
        address=data["address"]
    )
    
    await state.clear()
    
    await message.answer(
        f"Заказ №{order_id} успешно создан! Ожидайте доставку.",
        reply_markup=ReplyKeyboardRemove()
    )
``` 