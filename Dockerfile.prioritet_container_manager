FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    docker.io && \
    rm -rf /var/lib/apt/lists/*

RUN pip install docker psutil

COPY priority_manager.py .
COPY python_modules/ ./python_modules/

RUN ls -la /app

CMD ["python", "priority_manager.py"]